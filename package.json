{
  "name": "idobata-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run db:sync",
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run db:check",
    "start": "next start",
    "db:sync": "node scripts/sync-remote-schema.mjs",
    "db:check": "node scripts/sync-remote-schema.mjs --check",
    "db:status": "supabase migration list --linked",
    "db:lint": "supabase db lint --linked --level error --fail-on error",
    "db:test": "node scripts/test-remote-database.mjs",
    "db:deploy": "npm run db:sync && npm run db:lint",
    "db:verify": "npm run db:check && npm run db:lint",
    "flags": "node scripts/flags.mjs",
    "report:experiment": "node scripts/report.mjs experiment",
    "report:cost": "node scripts/report.mjs cost",
    "launch-check": "node scripts/launch-check.mjs",
    "content:schema": "node --experimental-strip-types scripts/generate-character-schemas.mjs",
    "content:seed": "node --experimental-strip-types scripts/seed-characters.mjs",
    "lint": "npm run lint:web && npm run lint:mobile",
    "lint:web": "eslint",
    "lint:mobile": "npm run lint --workspace @idobata/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:web": "next typegen && tsc --noEmit --incremental false",
    "typecheck:mobile": "npm run typecheck --workspace @idobata/mobile",
    "mobile:start": "npm run start --workspace @idobata/mobile",
    "mobile:ios": "npm run ios --workspace @idobata/mobile",
    "mobile:doctor": "npm run doctor --workspace @idobata/mobile",
    "mobile:export:ios": "npm run export:ios --workspace @idobata/mobile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@idobata/contracts": "*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
