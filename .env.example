SUPABASE_PROJECT_REF=replace-with-your-remote-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-remote-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-remote-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-remote-service-role-key
APP_URL=http://localhost:3000

# Google OAuth credentials used by Supabase Auth. Create a Web application in
# Google Cloud and register the Supabase callback URL shown in README.md.
# These values are consumed by the Supabase CLI/config, not by browser code.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional UI-only demo mode. Keep this false for persistent remote data. Never
# enable it in Preview or Production; src/instrumentation.ts fails closed there.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Optional OpenAI-compatible enhancement provider. Fallback AI engagement works without these.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-5.6-luna
# Clear this for models or compatible providers that do not accept reasoning_effort.
AI_CHAT_REASONING_EFFORT=low
AI_UTILITY_MODEL=gpt-4o-mini
# Optional global fallback for compatible providers. Purpose-specific model values above take precedence.
AI_MODEL=
# OpenAI GPT-5.6 uses max_completion_tokens. Set max_tokens for compatible providers that require the legacy field.
AI_MAX_TOKENS_PARAM=max_completion_tokens
# Comma-separated models the app is allowed to call. An id outside this list is
# refused at construction rather than silently appearing on the bill. Leave
# unset to use the built-in defaults; set it when using another provider's names.
AI_MODEL_ALLOWLIST=
# Set to "false" to stop every provider call without rotating the API key.
AI_ENABLED=true

# Pivot A character reactions, the distress check and the task splitter call
# Anthropic (claude-haiku-5-5) from the server only. Leave the key empty to use
# prewritten lines only; AI_ENABLED=false above also stops these calls.
ANTHROPIC_API_KEY=
# Deadlines in milliseconds. A reaction falls back to its prewritten line when
# the AI misses the deadline; the distress check shares it.
AI_REACTION_TIMEOUT_MS=2500
AI_SPLIT_TIMEOUT_MS=5000
# Cost meter: USD per million tokens, and the cache write/read multipliers on
# the input price. ai_usage_daily.est_cost_usd is computed from these.
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50
AI_PRICE_CACHE_WRITE_MULTIPLIER=1.25
AI_PRICE_CACHE_READ_MULTIPLIER=0.1
# AI caps per user. Plus and trial: per local day. Free: per rolling 7 local days.
AI_CAP_PLUS_DAILY_REACTIONS=30
AI_CAP_PLUS_DAILY_SPLITS=10
AI_CAP_FREE_WEEKLY_REACTIONS=3
# The AI reminder shows on the first reaction of each local day. Set a number
# of hours to also show it again after that long (empty = once a day).
AI_DISCLOSURE_MAX_GAP_HOURS=
# Pivot A cost guardrail. Once the UTC day's estimated AI spend (all users)
# reaches AI_DAILY_SPEND_LIMIT_USD, reactions use prewritten lines and splits
# answer "unavailable" until UTC midnight; the distress check keeps running.
# Empty = no limit; 0 stops AI reactions and splits. The daily cron
# (/api/cron/pivot-a-daily) warns from 80% of it, and when the projected AI
# cost per paying user per month is above AI_COST_ALERT_PER_PAYING_USER_USD
# (15% of $4.42 net).
AI_DAILY_SPEND_LIMIT_USD=
AI_COST_ALERT_PER_PAYING_USER_USD=0.66

# Pivot A age gate. AGE_VERIFIER picks the AgeVerifier. "self_attested" (the
# default) trusts the typed date of birth; it also needs
# ALLOW_SELF_ATTESTED_AGE=true and a deployment known not to be production,
# otherwise age checks answer 503 until a real provider is configured.
# Not production: APP_ENV is development, dev, local, test, staging or
# preview. Any other APP_ENV value ("production", "prod", a typo) is
# production. With APP_ENV unset: production when VERCEL_ENV=production, or,
# off Vercel, when NODE_ENV=production.
# On Vercel production only APP_ENV=staging or preview counts as not
# production. For local development set ALLOW_SELF_ATTESTED_AGE=true (and,
# when running a production build locally, APP_ENV=local); never set it on a
# production deployment.
AGE_VERIFIER=self_attested
ALLOW_SELF_ATTESTED_AGE=
APP_ENV=
# Off Vercel, the header your proxy sets to the client address (for example
# x-real-ip). Unset, public routes such as the age check share one coarse
# rate limit instead of limiting per address. Vercel's headers are used there.
CLIENT_IP_HEADER=

# Selective completed-task engagement caps. Values above the public-beta
# targets are clamped server-side to 5 likes, 2 replies, and 1 quote repost.
AI_ENGAGEMENT_MAX_LIKES=5
AI_ENGAGEMENT_MAX_REPLIES=2
AI_ENGAGEMENT_MAX_QUOTES=1
AI_ENGAGEMENT_CANDIDATE_POOL=8

# Generous public-beta cost guard for user messages sent to AI personas. This
# is enforced server-side per UTC day; human-to-human chat is not counted.
BETA_DAILY_CHAT_LIMIT=100

# Vercel Cron sends CRON_SECRET as an Authorization bearer token.
CRON_SECRET=replace-with-a-long-random-secret
WORKER_SECRET=replace-with-a-different-long-random-secret

# Set only after adding a server-side subscription cancellation adapter. Any
# non-"none" value blocks account deletion safely -- and so does setting
# STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET, which are read by the same guard.
# Leave all three unset until a cancellation adapter exists.
BILLING_PROVIDER=none
ACCOUNT_DELETION_AUDIT_SALT=replace-with-a-long-random-secret
